
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: profiles
    // Document ID: userId
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (required, enum: ADMIN, STUDENT)
    //   - instrument: string (enum: Violão, Piano)
    //   - level: string (enum: NZ, N1, N2, N3)
    //   - avatar: string
    //   - whatsapp: string
    //   - totalCompletedClasses: number
    //
    // Collection: courses
    // Document ID: courseId
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - instrument: string (required)
    //   - level: string (required)
    //   - description: string
    //   - modules: list
    //   - studentIds: list
    //
    // Collection: schedules
    // Document ID: scheduleId
    // Fields:
    //   - id: string (required)
    //   - studentId: string (required)
    //   - studentName: string
    //   - teacherId: string
    //   - date: string (required)
    //   - time: string (required)
    //   - instrument: string
    //   - status: string (required, enum: PENDING, COMPLETED, ABSENT)
    //   - title: string
    //
    // Collection: payments
    // Document ID: paymentId
    // Fields:
    //   - id: string (required)
    //   - studentId: string (required)
    //   - amount: number (required)
    //   - status: string (required, enum: PENDING, PAID, OVERDUE)
    //   - dueDate: string (required)
    //
    // Collection: materials
    // Document ID: materialId
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - fileUrl: string (required)
    //   - instrument: string (required)
    //   - level: string (required)
    //   - studentIds: list
    //   - courseId: string
    //
    // Collection: quotes
    // Document ID: quoteId
    // Fields:
    //   - id: string (required)
    //   - text: string (required)
    //   - author: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'ADMIN' ||
          (request.auth.token.email == "comotocarhinos@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProfile(data) {
      return hasRequiredFields(['id', 'name', 'email', 'role']) &&
             data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.role in ['ADMIN', 'STUDENT'] &&
             (!('instrument' in data) || data.instrument in ['Violão', 'Piano']) &&
             (!('level' in data) || data.level in ['NZ', 'N1', 'N2', 'N3']) &&
             (!('totalCompletedClasses' in data) || data.totalCompletedClasses is number);
    }

    function isValidCourse(data) {
      return hasRequiredFields(['id', 'title', 'instrument', 'level']) &&
             data.id is string && data.title is string && data.title.size() < 200 &&
             data.instrument is string && data.level is string &&
             (!('modules' in data) || data.modules is list) &&
             (!('studentIds' in data) || data.studentIds is list);
    }

    function isValidSchedule(data) {
      return hasRequiredFields(['id', 'studentId', 'date', 'time', 'status']) &&
             data.id is string && data.studentId is string &&
             data.date is string && data.time is string &&
             data.status in ['PENDING', 'COMPLETED', 'ABSENT'];
    }

    function isValidPayment(data) {
      return hasRequiredFields(['id', 'studentId', 'amount', 'status', 'dueDate']) &&
             data.id is string && data.studentId is string &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['PENDING', 'PAID', 'OVERDUE'] &&
             data.dueDate is string;
    }

    function isValidMaterial(data) {
      return hasRequiredFields(['id', 'title', 'fileUrl', 'instrument', 'level']) &&
             data.id is string && data.title is string && data.fileUrl is string &&
             data.instrument is string && data.level is string &&
             (!('studentIds' in data) || data.studentIds is list);
    }

    function isValidQuote(data) {
      return hasRequiredFields(['id', 'text', 'author']) &&
             data.id is string && data.text is string && data.text.size() < 1000 &&
             data.author is string && data.author.size() < 100;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProfile(request.resource.data) && 
                      (isOwner(userId) && request.resource.data.role == 'STUDENT' || isAdmin());
      allow update: if isAuthenticated() && isValidProfile(request.resource.data) && 
                      (isOwner(userId) && request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidCourse(request.resource.data);
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidSchedule(request.resource.data);
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.studentId) || isAdmin();
      allow write: if isAdmin() && isValidPayment(request.resource.data);
    }

    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidMaterial(request.resource.data);
    }

    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidQuote(request.resource.data);
    }
  }
}
