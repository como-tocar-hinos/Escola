
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "STUDENT"] },
        "instrument": { "type": "string", "enum": ["Violão", "Piano"] },
        "level": { "type": "string", "enum": ["NZ", "N1", "N2", "N3"] },
        "avatar": { "type": "string" },
        "whatsapp": { "type": "string" },
        "totalCompletedClasses": { "type": "integer" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Course information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "instrument": { "type": "string" },
        "level": { "type": "string" },
        "description": { "type": "string" },
        "modules": { "type": "array", "items": { "type": "object" } },
        "studentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "instrument", "level"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Class schedule information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "instrument": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "ABSENT"] },
        "title": { "type": "string" }
      },
      "required": ["id", "studentId", "date", "time", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PAID", "OVERDUE"] },
        "dueDate": { "type": "string" }
      },
      "required": ["id", "studentId", "amount", "status", "dueDate"]
    },
    "Material": {
      "title": "Material",
      "description": "Course material information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileUrl": { "type": "string" },
        "instrument": { "type": "string" },
        "level": { "type": "string" },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "courseId": { "type": "string" }
      },
      "required": ["id", "title", "fileUrl", "instrument", "level"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Inspirational quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" }
      },
      "required": ["id", "text", "author"]
    }
  },
  "firestore": {
    "/profiles/{userId}": { "schema": "UserProfile", "description": "User profiles" },
    "/courses/{courseId}": { "schema": "Course", "description": "Courses" },
    "/schedules/{scheduleId}": { "schema": "Schedule", "description": "Schedules" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Payments" },
    "/materials/{materialId}": { "schema": "Material", "description": "Materials" },
    "/quotes/{quoteId}": { "schema": "Quote", "description": "Quotes" }
  }
}
